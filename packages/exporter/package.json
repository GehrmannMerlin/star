{
  "name": "@stellaris/exporter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./excel.js": {
      "types": "./dist/excel.d.ts",
      "default": "./dist/excel.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellaris/contracts": "workspace:*",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@types/exceljs": "1.3.2",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
