{
  "name": "@stellaris/evidence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store.js": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellaris/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
