{
  "name": "stellaris-crawler",
  "version": "0.0.0",
  "private": true,
  "description": "全国行政区官员岗位信息 URL 采集系统",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @stellaris/backend dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "test:tencent-release": "python3 -m unittest discover -s tests -p 'test_tencent_release_*.py' -v",
    "verify:tencent-release": "pnpm test:tencent-release && node --test tests/tencent-deploy-config.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
