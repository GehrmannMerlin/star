{
  "name": "stellaris-crawler",
  "version": "0.0.0",
  "private": true,
  "description": "??????????? URL ????",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @stellaris/backend dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "test:tencent-release": "python3 -m unittest discover -s tests -p 'test_tencent_release_*.py' -v",
    "verify:tencent-release": "pnpm test:tencent-release && node --test tests/tencent-deploy-config.test.mjs",
    "verify:official-skill": "node scripts/verify-official-biography-skill.mjs",
    "agent:runtime:doctor": "pnpm --filter @stellaris/agent-runtime runtime:doctor",
    "agent:smoke:deepseek": "pnpm --filter @stellaris/agent-runtime smoke:deepseek",
    "agent:smoke:search": "pnpm --filter @stellaris/agent-runtime smoke:search",
    "agent:smoke:fetch": "pnpm --filter @stellaris/agent-runtime smoke:fetch",
    "agent:smoke:render": "pnpm --filter @stellaris/agent-runtime smoke:render",
    "agent:smoke:inspect": "pnpm --filter @stellaris/agent-runtime smoke:inspect",
    "agent:smoke:inventory": "pnpm --filter @stellaris/agent-runtime smoke:inventory",
    "agent:smoke:investigation": "pnpm --filter @stellaris/agent-runtime smoke:investigation",
    "agent:smoke:evidence": "pnpm --filter @stellaris/agent-runtime smoke:evidence"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
